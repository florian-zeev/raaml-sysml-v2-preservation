{
  "name": "@florian-zeev/raaml-sysml-v2-preservation",
  "version": "0.1.0-rc.2",
  "description": "A two-way mapping that preserves the defined canonical facts of the normative RAAML 1.1 definitions between SysML v1 and SysML v2.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "!dist/*.test.d.ts",
    "!dist/*.test.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/florian-zeev/raaml-sysml-v2-preservation",
    "directory": "typescript"
  },
  "homepage": "https://github.com/florian-zeev/raaml-sysml-v2-preservation#readme",
  "bugs": {
    "url": "https://github.com/florian-zeev/raaml-sysml-v2-preservation/issues"
  },
  "keywords": [
    "raaml",
    "sysml",
    "sysml-v2",
    "safety-engineering",
    "model-transformation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.8.3"
  }
}
